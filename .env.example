# 复制为 .env 并填入真实凭证。缺失项对应模块会显示 SKIP，不影响脚手架运行。

# ---- 通用 ----
DB_PATH=
HEALTH_FAIL_THRESHOLD=3

# ---- 客服模块（闲鱼）：网页端 goofish.com 登录后 F12 复制 cookie ----
XIANYU_COOKIE=
XIANYU_USER_ID=
# XianYuApis 库路径，留空则自动查找 vendor/XianYuApis 或与项目同级的 XianYuApis
XIANYU_APIS_PATH=
# 拟人回复延迟（秒），降低秒回的机器人特征
REPLY_DELAY_MIN=3
REPLY_DELAY_MAX=12

# ---- 选品模块 ----
# 数据源：onebound（万邦，1000 起充）/ justoneapi（按次小额充值，推荐验证用）
SOURCING_PROVIDER=onebound
# 万邦 Onebound（付费）：open.onebound.cn 注册获取
ONEBOUND_API_KEY=
ONEBOUND_API_SECRET=
# justoneapi（按次计费）：api.justoneapi.com 注册控制台获取 token
JUSTONEAPI_TOKEN=
# 接入地址，默认大陆专用 IP；海外可改 https://api.justoneapi.com
JUSTONEAPI_BASE=http://47.117.133.51:30015
# 跨境选品默认渠道（逗号分隔 key，见 platforms.PROFILES：tiktok_us/tiktok_uk/aliexpress）
OVERSEAS_PLATFORMS=tiktok_us,aliexpress

# ---- 推广模块（小红书/抖音）：网页端登录后取 cookie ----
XHS_COOKIE=
DOUYIN_COOKIE=

# ---- LLM ----
LLM_PROVIDER=qwen
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_ENDPOINT=https://api.deepseek.com/chat/completions
ANTHROPIC_API_KEY=

# ---- 商品 RAG（可选，爬虫由外部系统负责，输入 JSONL 由独立导入命令处理）----
RAG_ENABLED=false
RAG_DATABASE_URL=
RAG_EMBEDDING_MODEL_PATH=BAAI/bge-m3
RAG_EMBEDDING_DEVICE=auto
RAG_EMBEDDING_BATCH_SIZE=16
RAG_TOP_K=5
RAG_MIN_SCORE=0.50

# ---- 告警（飞书/钉钉/企微机器人 webhook，可留空走控制台打印）----
ALERT_WEBHOOK=
