{
  "manifest_version": 3,
  "name": "商品 RAG 本地采集器",
  "version": "0.1.0",
  "description": "手动采集当前闲鱼商品详情页可见资料到本机 RAG 测试集。",
  "permissions": ["activeTab", "storage", "tabs", "alarms"],
  "host_permissions": [
    "https://*.goofish.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "采集当前商品", "default_popup": "popup.html"},
  "content_scripts": [{
    "matches": ["https://*.goofish.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
